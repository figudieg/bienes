# Copia este archivo a frontend/.env y ajusta los valores según la máquina donde
# corras el proyecto (frontend/.env NO se sube al repositorio).

# URL base del backend (API) que va a usar el frontend compilado.
#   - Desarrollo local (todo en la misma máquina): http://localhost:8000/api
#   - Demo/pruebas por red local:                  http://<tu-ip-de-red>:8000/api
#   - Servidor de calidad / producción:            http://<dominio-o-ip-del-servidor>:8000/api
API_URL=http://localhost:8000/api

# true en el servidor de calidad/producción (compilado con "npm run build").
# false en desarrollo local (con "npm start" / ng serve).
PRODUCTION=false
